# ============================================
# Audio Downloader - .gitignore
# ============================================

# ==================== Python ====================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Translations
*.mo
*.pot

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# ==================== IDE & Editors ====================
# PyCharm
.idea/
*.iml
*.iws

# VS Code
.vscode/
*.code-workspace

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#

# ==================== OS Files ====================
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory

# ==================== Application Runtime Data ====================
# 运行时生成的目录（根据 app_initializer/directory_setup.py）
Log/
Data/
Music/
*.log
*.log.*

# ==================== Configuration Files ====================
# 用户配置文件（包含个性化设置，不应提交）
audio_downloader_config.yaml
*.yaml.bak
*.yml.bak

# ==================== Selenium & Browser ====================
# Selenium WebDriver 下载文件
msedgedriver*
chromedriver*
geckodriver*
*.exe.driver

# Selenium debug files
selenium-debug.log

# ==================== Media Files ====================
# 音频/视频文件（运行时生成）
*.mp3
*.mp4
*.flac
*.wav
*.m4a
*.aac
*.ogg
*.mkv
*.webm
*.avi
*.mov

# ==================== Temporary Files ====================
# 临时文件和目录
*.tmp
*.temp
temp/
tmp/
*.bak
*.old
*.orig

# ==================== Archives ====================
*.zip
*.tar.gz
*.rar
*.7z

# ==================== Database ====================
*.db
*.sqlite
*.sqlite3

